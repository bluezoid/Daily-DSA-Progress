# MongoDB Atlas SRV connection string (database user with readWrite on MONGODB_DB_NAME only)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=daily_dsa_progress
# At least 32 bytes of randomness. Generate with: openssl rand -base64 48
JWT_SECRET=
# Public base URL of the app (no trailing slash)
APP_URL=http://localhost:3000
